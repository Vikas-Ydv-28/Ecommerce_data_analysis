--Q1. What are the total revenue, total delivered orders, total units sold and average order value (AOV) for the business?

select
       extract(year from o.order_date) as order_year,
       sum(oi.line_total) as total_revenue, count(o.order_id) as count_orders,
       sum(oi.quantity) as total_units,
       round(sum(oi.line_total)/count(o.order_id),2) as AOV
from orders o join order_items oi on  o.order_id=oi.order_id
         group by extract(year from o.order_date) 

--Q2. How is revenue changing month over month? Identify the months with the highest and lowest revenue and calculate month-over-month growth.


WITH monthly_revenue AS (
    SELECT
DATE_TRUNC('month', o.order_date)::DATE AS month,
SUM(oi.line_total) AS revenue
FROM orders o
INNER JOIN order_items oi
ON o.order_id = oi.order_id
WHERE o.order_status = 'Delivered'
GROUP BY DATE_TRUNC('month', o.order_date)::DATE
),

-- Generate all months in the order date range
month_series AS (
    SELECT
        GENERATE_SERIES(
            DATE_TRUNC('month', MIN(order_date)),
            DATE_TRUNC('month', MAX(order_date)),
            INTERVAL '1 month'
        )::DATE AS month
    FROM orders
),

-- Include months with zero delivered revenue
monthly_summary AS (
SELECT
ms.month,
COALESCE(mr.revenue, 0) AS monthly_revenue
FROM month_series ms
LEFT JOIN monthly_revenue mr
 ON ms.month = mr.month
),

-- Calculate previous month's revenue
revenue_comparison AS (
    SELECT
 month,
monthly_revenue,LAG(monthly_revenue) OVER (
ORDER BY month
) AS previous_month_revenue
FROM monthly_summary
),

-- Calculate month-over-month growth
final_analysis AS (
    SELECT
        month,
        monthly_revenue,
        previous_month_revenue,

        monthly_revenue - previous_month_revenue
            AS revenue_change,

        ROUND(
            (
                (monthly_revenue - previous_month_revenue)
                / NULLIF(previous_month_revenue, 0)
            ) * 100,
            2
        ) AS mom_growth_percentage

    FROM revenue_comparison
)

SELECT
    TO_CHAR(month, 'Mon YYYY') AS month,
    monthly_revenue,
    previous_month_revenue,
    revenue_change,
    mom_growth_percentage,

    CASE
        WHEN monthly_revenue = MAX(monthly_revenue) OVER()
        THEN 'Highest Revenue'
        WHEN monthly_revenue = MIN(monthly_revenue) OVER()
        THEN 'Lowest Revenue'
        ELSE 'Normal'
    END AS revenue_performance

FROM final_analysis
ORDER BY month;


